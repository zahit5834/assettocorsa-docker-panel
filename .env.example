# =====================================================
# Assetto Corsa Docker Multi-Server Panel (.env)
# =====================================================

# Panelin dinleyeceği port (Varsayılan: 5829)
PANEL_PORT=5829

# Linux VDS genel IP adresiniz (Oyuncu davet linkleri ve Content Manager bağlantısı için)
# Örnek: 185.123.45.67
VDS_PUBLIC_IP=127.0.0.1

# İlk kurulum admin kullanıcı adı ve şifresi (ilk girişten sonra panelden değiştirilebilir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# JWT oturum gizli anahtarı (install.sh otomatik rastgele üretir)
JWT_SECRET=replace-with-a-long-random-secret-key

# Linux VDS üzerinde proje ve verilerin saklanacağı mutlak host yolları (install.sh otomatik ayarlar)
HOST_PROJECT_DIR=.
HOST_DATA_DIR=./data

# AssettoServer resmi Docker imajı
ASSETTOSERVER_IMAGE=compujuckel/assettoserver:latest

# Vanilla Kunos acServer lokal Docker imajı
VANILLA_AC_IMAGE=ac-panel-vanilla:latest

# Zaman dilimi
TZ=Europe/Istanbul
